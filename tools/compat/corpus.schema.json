{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kytyps5.local/schemas/compatibility-corpus-v1.json",
  "title": "KytyPS5 local compatibility corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "titles"],
  "properties": {
    "schema_version": {"const": 1},
    "titles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title_id", "game_path"],
        "properties": {
          "title_id": {"type": "string", "pattern": "^PPSA[0-9]{5}$"},
          "game_path": {"type": "string", "minLength": 1},
          "patch_path": {"type": "string", "minLength": 1},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
          "repeat": {"type": "integer", "minimum": 1, "maximum": 100},
          "arguments": {
            "type": "array",
            "items": {"type": "string"},
            "default": []
          }
        }
      }
    }
  }
}
